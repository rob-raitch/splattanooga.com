---
// src/layouts/Layout.astro
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Preload fonts from same origin to prevent layout shift in Safari -->
    <link rel="preload" href="/fonts/Flavors.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Quicksand.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-flavors: 'Flavors', cursive, sans-serif;
    --font-quicksand: 'Quicksand', system-ui, -apple-system, sans-serif;
  }
  /* 1. Define Local Flavors Font */
  @font-face {
    font-family: 'Flavors';
    src: url('/fonts/Flavors.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* 2. Define Local Quicksand Font */
  @font-face {
    font-family: 'Quicksand';
    src: url('/fonts/Quicksand.woff2') format('woff2');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  /* 3. Global Styles */
  body, p, li, span, a {
    font-family: 'Quicksand', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }

  /* Force Flavors on headers and logo */
  h1, h2, h3, .fancy-heading, .brand-logo {
    font-family: 'Flavors', cursive, sans-serif !important;
    font-weight: 400 !important;
  }
</style>