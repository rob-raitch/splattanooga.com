---
// src/layouts/Layout.astro
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Google Fonts Preconnect & Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Flavors&family=Quicksand:wght@300..700&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* 1. Define the variables globally at the root */
  :root {
    --font-flavors: 'Flavors', cursive, sans-serif;
    --font-quicksand: 'Quicksand', system-ui, -apple-system, sans-serif;
  }

  /* 2. Global Body Text */
  body, p, li, span, a {
    font-family: var(--font-quicksand);
    line-height: 1.6;
  }

  /* 3. Global Headings & Brand Logo */
  h1, h2, h3, .fancy-heading, .brand-logo {
    font-family: var(--font-flavors) !important;
    font-weight: 400 !important; /* Flavors only exists in weight 400 */
  }
</style>