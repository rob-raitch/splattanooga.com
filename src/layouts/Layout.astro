---
// src/layouts/Layout.astro
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Google Fonts for Flavors and Quicksand -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Flavors&family=Quicksand:wght@300;400;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* 1. Body & Paragraph typography */
  body, p, li, span, a {
    font-family: 'Quicksand', system-ui, sans-serif;
    line-height: 1.6;
  }

  /* 2. Brand headings & Flavors logo */
  h1, h2, h3, .fancy-heading, .brand-logo {
    font-family: 'Flavors', cursive, sans-serif;
    font-weight: 400; /* Flavors only exists in weight 400 */
  }
</style>