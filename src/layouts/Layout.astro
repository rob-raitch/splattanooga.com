---
// src/layouts/Layout.astro
import '@fontsource/flavors';
import '@fontsource/quicksand/400.css';
import '@fontsource/quicksand/600.css';
import '@fontsource/quicksand/700.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
 </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-flavors: 'Flavors', cursive, sans-serif;
    --font-quicksand: 'Quicksand', system-ui, -apple-system, sans-serif;
  }

  body, p, li, span, a, h2, h3, h4, h5, h6 {
    font-family: var(--font-quicksand);
    line-height: 1.6;
  }

  h1, .fancy-heading, .brand-logo, [class*="logo"] {
    font-family: var(--font-flavors) !important;
    font-weight: 400 !important;
  }
</style>