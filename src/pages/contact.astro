---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact — Splattanooga"
  description="Get in touch and connect with Splattanooga."
>
  <header class="navbar">
    <div class="nav-container">
      <a href="/" class="brand-logo">splattanooga</a>
      <nav>
        <a href="/#search-widget">Learn More</a>
        <a href="/#about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </header>

  <main class="page-container">
    <h1>Contact & Links</h1>
    
    <section class="blurb-section">
      <h2>Hi, I'm Rob.</h2>
      <p>
        I'm passionate about exploring the intersection of technology, art, and spatial storytelling. 
        Through Splattanooga, my goal is to make volumetric capture, like Gaussian Splatting, accessible to our local community in the Greater Chattanooga area. 
        Whether you want to collaborate, learn, or just talk tech, feel free to reach out!
      </p>
      <a href="mailto:rob@splattanooga.com" class="btn btn-primary contact-btn">Email Me</a>
    </section>

    <section class="links-section">
      <h2>Connect & Explore</h2>
      <p class="links-subtitle">Here are some tools I love and places you can find me online.</p>
      
      <div class="links-grid">
        <a href="https://superspl.at/user/raitch" target="_blank" rel="noopener noreferrer" class="link-card">
          <h3>My SuperSplat Gallery</h3>
          <p>An amazing open-source tool for editing and optimizing 3D Gaussian Splats in the browser.</p>
        </a>
        
        <a href="https://scaniverse.com/@raitch" target="_blank" rel="noopener noreferrer" class="link-card">
          <h3>My Scaniverse Gallery</h3>
          <p>Scaniverse is a mobile app for capturing 3D scans and generating Gaussian Splats right from your phone.</p>
        </a>

        <a href="https://www.linkedin.com/in/raitch" target="_blank" rel="noopener noreferrer" class="link-card">
          <h3>LinkedIn</h3>
          <p>Connect with me here. Follow my updates on 3D capture, consulting, and community workshops. Check out my history, I have been very fortunate to work with such amazing people!</p>
        </a>

        <a href="https://arrival.space/rob-aitchison" target="_blank" rel="noopener noreferrer" class="link-card">
          <h3>arrival.space</h3>
          <p>A platform for authoring, exploring, and sharing immersive spaces. So many cool profiles to explore there, plan your visits!</p>
        </a>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-links">
      <a href="https://docs.google.com/document/d/e/2PACX-1vQMXDCuW_JNd8BSX4dcvETfEPcR3Fz2oGRHp8ZmXq72x8PSdI2u78S0WWxOEfQyL0RskgGHXwRwUPC-/pub" 
         target="_blank" 
         rel="noopener noreferrer">Survey Report ↗</a>
      <a href="/privacy">Privacy Policy</a>
    </div>
    <p>© 2026 Splattanooga. All rights reserved.</p>
  </footer>
</Layout>

<style>
  :root {
    --bg-dark: #0f1115;
    --bg-surface: #15181e;
    --border: rgba(255, 255, 255, 0.12);
    --border-strong: rgba(255, 255, 255, 0.25);
    --text-main: #f4f4f0;
    --text-muted: #8a8f98;
    --accent: hsl(25, 100%, 50%);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .brand-logo {
    font-family: var(--font-flavors);
    font-size: 2.25rem;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    line-height: 1.2;
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 17, 21, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 2rem;
  }

  .nav-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  nav { display: flex; gap: 2rem; align-items: center; }

  nav a, .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  nav a:hover, .footer-links a:hover { color: var(--accent); }

  .page-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    min-height: 70vh;
  }

  h1 {
    font-family: 'Quicksand', sans-serif;
    font-size: 2.5rem;
    margin-bottom: 3rem;
    background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-align: center;
  }

  .blurb-section {
    background: var(--bg-surface);
    padding: 2.5rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    margin-bottom: 4rem;
    text-align: center;
  }

  .blurb-section h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: var(--text-main);
  }

  .blurb-section p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 650px;
    margin: 0 auto 2rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--border) 0%, var(--accent) 100%);
    color: #fff;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 102, 0, 0.25);
  }

  .links-section h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .links-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .link-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
  }

  .link-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .link-card h3 {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .link-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  footer {
    text-align: center;
    padding: 3rem 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
    justify-content: center;
  }
</style>
