---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../components/SearchWidget.astro';

const narrativePreviews = [
  {
    title: 'Country Garage',
    platform: 'Voluma',
    description: 'A comparison of different capture apps.',
    href: 'https://voluma.ai/show/splattanooga/ford-truck/country-garage',
    image: 'https://assets.voluma.ai/splattanooga/ford-truck/.thumbs/4369_1790690608313_thumb.webp',
    imageAlt: 'Country Garage Gaussian Splat preview',
  },
  {
    title: 'ASL + FUN where Paula stands',
    platform: 'Splatware',
    description: 'An interactive virtual tour of a Northshore splat.',
    href: 'https://splatware.com/tour/fb0c678c-ebea-42c7-b602-c00c0ace2556',
    image: 'https://firebasestorage.googleapis.com/v0/b/virtual-spatial-tour-b3261.appspot.com/o/thumbnails%2Ffb0c678c-ebea-42c7-b602-c00c0ace2556%2Fwaypoint-1.jpg?alt=media',
    imageAlt: 'ASL plus FUN virtual tour preview',
  },
  {
    title: 'Map based storytelling with splats',
    platform: 'Cesium Ion',
    description: 'A way to register your splats with real world location data.',
    href: 'https://ion.cesium.com/stories/viewer/?id=eb4bc5f6-74f2-46e1-9cb9-26a85eee9d32',
    image: '/images/cesium-ion-story.webp',
    imageAlt: 'Cesium Ion story view of a 3D scene in Chattanooga',
  },
  {
    title: 'Sculpture Fields Visit',
    platform: 'Real Horizons',
    description: 'Showcasing how to capture a splat at Sculpture Fields.',
    href: 'https://studio.realhorizons.ai/tours/e8c99da4-4908-4445-bc2f-4c1ce0d1ddef/view',
    image: '/images/real-horizons-sculpture-fields.webp',
    imageAlt: '"Angel" sculpture at Sculpture Fields in a 3D scene',
  },
];
---

<Layout 
  title="Splattanooga | Gaussian Splatting & Community Arts Consulting in Chattanooga"
  description="Splattanooga brings Gaussian Splatting, 3D scanning, and digital twin workflows to local arts organizations, creatives, and cultural heritage projects across the Greater Chattanooga area."
>
  <Fragment slot="head">
    <meta property="og:title" content="Splattanooga | Gaussian Splatting for Chattanooga" />
    <meta property="og:description" content="Explore community arts consulting, workshops, and 3D capture training that bridges technology, creativity, and local storytelling." />
    <meta property="og:type" content="website" />
  </Fragment>
  <header class="navbar">
    <div class="nav-container">
      <a href="/" class="brand-logo">splattanooga</a>
      <nav>
        <a href="#search-widget">Learn More</a>
        <a href="#about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="welcome-terminal" aria-label="Welcome message">
      <div class="terminal-bar">
        <div class="terminal-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <span class="terminal-label">SPLATTANOOGA://WELCOME</span>
        <button class="terminal-replay" type="button">↻ Replay</button>
      </div>
      <p class="welcome-intro">
        <span class="visually-hidden">Welcome to the website, we are glad you are here! Please take a look around and get in touch to carry on the conversation, thank you!!</span>
        <span class="typing-text" aria-hidden="true">Welcome to the website, we are glad you are here! Please take a look around and get in touch to carry on the conversation, thank you!!</span>
      </p>
    </section>
    <section class="narrative-previews" aria-labelledby="narrative-previews-title">
      <h2 id="narrative-previews-title">
        We are experimenting with different narrative creation <em>"splatforms"</em><br>
      </h2>
      <h3>Please explore some of our recent narrative experiments below. Each platform offers unique features and experiences, showcasing the versatility of Gaussian Splatting and 3D capture techniques in storytelling.<br>
        *Desktop and mobile browsers are supported, however, your experience mileage may vary depending on your device and browser capabilities. We are keen to hear your feedback and suggestions for future narrative experiments.
      </h3>
      <br><br>
      <div class="preview-grid">
        {narrativePreviews.map((preview) => (
          <a
            class="preview-card"
            href={preview.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${preview.title} on ${preview.platform} (opens in a new tab)`}
          >
            <div class:list={['preview-media', { 'preview-media--image': preview.image }]}>
              {preview.image ? (
                <img src={preview.image} alt={preview.imageAlt} loading="lazy" />
              ) : (
                <span class="preview-placeholder" aria-hidden="true">StorySplat</span>
              )}
              <span class="preview-open">Open in new tab ↗</span>
            </div>
            <div class="preview-details">
              <div>
                <p class="preview-platform">{preview.platform}</p>
                <h3>{preview.title}</h3>
                <p class="preview-description">{preview.description}</p>
              </div>
              <span class="preview-arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Hero Section -->
    <section class="hero">
      <span class="badge">Community Arts | Reality Capture | Consulting</span>
      <h2 class="hero-title">Gaussian Splatting for Chattanooga</h2>
      <p class="hero-subtitle">
        Exploring Gaussian Splatting, Radiance Fields, 3D scanning, and digital twin workflows across local arts, historical preservation, and creative pipelines in the Greater Chattanooga area.<br>
        Get hands-on with in-depth training, workshops, and collaborative projects that bridge technology and creativity.
      </p>
      
      <div class="cta-group">
        <a href="/contact" class="btn btn-primary">Get in touch</a>
        <a href="#search-widget" class="btn btn-secondary">Learn More</a>
      </div>
    </section>

    <SearchWidget />

    <!-- About Section -->
    <section id="about" class="about-section">
      <div class="container">
        <div class="section-header">
          <h2>Bringing Splats to Chattanooga</h2>
          <p>
            Splattanooga bridges advanced 3D capture methods with real-world creative application, making volumetric capture accessible for local projects and creative professionals.<br>
            <b>Our mission is to empower the community with tools, knowledge, and collaborative opportunities to explore the intersection of technology, art, and spatial storytelling.</b>
          </p>
        </div>

        <div class="grid">
          <div class="card">
            <span class="card-icon">✨</span>
            <h3>Q. What?<br>A. Gaussian Splat Training</h3>
            <p>
              Introductory courses and workshops on Gaussian Splatting, from capture considerations through delivery possibilities.<br>
            </p>
            <div class="about-answer">
              <h3>Q. What else?<br>A. Spatial Media processing</h3>
              <p>Explore possibilities for processing and utilizing your existing media in various creative and professional contexts.</p>
            </div>
            <div class="about-answer">
              <h3>Q. Why now?<br>A. Be ready for the spatial revolution</h3>
              <p>The spatial web is here. 3D Gaussian Splatting turns real environments into photorealistic, interactive 3D worlds in minutes; no heavy apps, mesh cleanup, or long render times. Build for spatial browsers now and capture attention before photorealism becomes the bare minimum.</p>
            </div>
          </div>

          <div class="card">
            <span class="card-icon">🎨</span>
            <h3>Q. Who?<br>A. Community & Arts Organizations, Artists, Creatives of all types</h3>
            <p>
              Enabling local creative teams, galleries, museums, and digital artists with modern 3D pipelines, workshops, and empowerment to start generating and owning their spatial content.<br>
              Get in touch to learn more.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-links">
      <a href="https://docs.google.com/document/d/e/2PACX-1vQMXDCuW_JNd8BSX4dcvETfEPcR3Fz2oGRHp8ZmXq72x8PSdI2u78S0WWxOEfQyL0RskgGHXwRwUPC-/pub" 
         target="_blank" 
         rel="noopener noreferrer">Survey Report ↗</a>
      <a href="/privacy">Privacy Policy</a>
    </div>
    <p>© 2026 Splattanooga. All rights reserved.</p>
  </footer>
</Layout>

<script>
  const terminal = document.querySelector<HTMLElement>('.welcome-terminal');
  const typingText = terminal?.querySelector<HTMLElement>('.typing-text');
  const replayButton = terminal?.querySelector<HTMLButtonElement>('.terminal-replay');
  const welcomeMessage = typingText?.textContent ?? '';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let typingTimer: number | undefined;

  const playWelcomeMessage = () => {
    if (!typingText) return;

    window.clearInterval(typingTimer);
    typingText.classList.remove('typing-complete');

    if (reducedMotion) {
      typingText.textContent = welcomeMessage;
      typingText.classList.add('typing-complete');
      return;
    }

    const characters = Array.from(welcomeMessage);
    typingText.textContent = '';
    let index = 0;
    typingTimer = window.setInterval(() => {
      typingText.textContent += characters[index++];

      if (index === characters.length) {
        window.clearInterval(typingTimer);
        typingText.classList.add('typing-complete');
      }
    }, 70);
  };

  if (typingText) {
    playWelcomeMessage();
    replayButton?.addEventListener('click', playWelcomeMessage);
  }
</script>

<style>
  /* All your page CSS remains here, but remove hardcoded font overrides */
  :root {
    --bg-dark: #0f1115;
    --bg-surface: #15181e;
    --border: rgba(255, 255, 255, 0.12);
    --border-strong: rgba(255, 255, 255, 0.25);
    --text-main: #f4f4f0;
    --text-muted: #8a8f98;
    --accent: hsl(25, 100%, 50%);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .brand-logo {
    font-family: var(--font-flavors);
    font-size: 2.25rem;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    line-height: 1.2;
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 17, 21, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 2rem;
  }

  .nav-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  nav { display: flex; gap: 2rem; align-items: center; }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  nav a:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .nav-container {
      flex-direction: column;
      gap: 1rem;
    }
    nav {
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .navbar {
      padding: 1rem;
    }
  }

  .hero {
    min-height: 75vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1.5rem 2rem;
    position: relative;
  }

  .welcome-intro {
    margin: 0;
    padding: 1.5rem clamp(1.25rem, 4vw, 3rem) 2rem;
    color: #d7f7e1;
    font-family: var(--font-mono), monospace;
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    line-height: 1.8;
    text-align: left;
  }

  .welcome-terminal {
    max-width: 900px;
    margin: 2rem auto 0;
    overflow: hidden;
    border: 1px solid rgba(112, 220, 150, 0.3);
    border-radius: 12px;
    background: #101713;
    box-shadow: 0 16px 42px rgba(0, 0, 0, 0.35), 0 0 30px rgba(112, 220, 150, 0.06);
  }

  .terminal-bar {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid rgba(112, 220, 150, 0.18);
    background: #19221c;
  }

  .terminal-dots {
    display: flex;
    gap: 0.4rem;
  }

  .terminal-dots span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #f27b72;
  }

  .terminal-dots span:nth-child(2) { background: #e8c66a; }
  .terminal-dots span:nth-child(3) { background: #77cc86; }

  .terminal-label {
    color: #91a995;
    font-family: var(--font-mono), monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .terminal-replay {
    border: 1px solid rgba(145, 169, 149, 0.35);
    border-radius: 5px;
    padding: 0.3rem 0.6rem;
    background: transparent;
    color: #d7f7e1;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .terminal-replay:hover,
  .terminal-replay:focus-visible {
    border-color: #77cc86;
    background: rgba(119, 204, 134, 0.12);
  }

  .terminal-replay:focus-visible {
    outline: 2px solid #77cc86;
    outline-offset: 3px;
  }

  .typing-text {
    border-right: 2px solid #77cc86;
    animation: typing-cursor 0.8s steps(2, start) infinite;
  }

  .typing-text.typing-complete {
    border-right: 0;
    animation: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes typing-cursor {
    to { border-color: transparent; }
  }

  @media (max-width: 640px) {
    .welcome-terminal {
      margin: 1.5rem 1rem 0;
    }

    .terminal-label {
      font-size: 0.6rem;
    }
  }

  .narrative-previews {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .narrative-previews h2 {
    max-width: 760px;
    margin: 0 auto 1.75rem;
    text-align: center;
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    line-height: 1.35;
  }

  .narrative-previews > h3 {
    max-width: 760px;
    margin: 0 auto 1.75rem;
    text-align: center;
    font-size: clamp(0.85rem, 3vw, 0.85rem);
    line-height: 1.35;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .preview-card {
    overflow: hidden;
    color: var(--text-main);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-surface);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .preview-card:hover,
  .preview-card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .preview-media {
    position: relative;
    display: grid;
    min-height: 190px;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 30%, rgba(255, 142, 43, 0.24), transparent 38%),
      linear-gradient(135deg, #252b35, #12151b);
  }

  .preview-media--image img {
    width: 100%;
    height: 190px;
    object-fit: cover;
  }

  .preview-placeholder {
    color: var(--text-main);
    font-family: var(--font-flavors);
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .preview-open {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    background: rgba(15, 17, 21, 0.82);
    color: var(--text-main);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .preview-details {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.1rem 1.15rem;
  }

  .preview-platform {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .preview-details h3 {
    margin: 0.15rem 0 0.25rem;
    font-size: 1.15rem;
  }

  .preview-description {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .preview-arrow {
    color: var(--accent);
    font-size: 1.25rem;
  }

  @media (max-width: 640px) {
    .preview-grid {
      grid-template-columns: 1fr;
    }

    .preview-media,
    .preview-media--image img {
      min-height: 170px;
      height: 170px;
    }
  }

  .hero-title {
    font-family: 'Quicksand', sans-serif;
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 3rem);
    line-height: 1.2;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #ffffff 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    max-width: 680px;
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid var(--border);
    color: var(--accent);
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cta-group { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }

  .btn {
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--border) 0%, var(--accent) 100%);
    color: #fff;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 229, 255, 0.25);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: var(--text-main);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--text-muted);
  }

  .about-section {
    padding: 6rem 1.5rem;
    border-top: 1px solid var(--border);
    background: radial-gradient(circle at 50% 0%, rgba(112, 0, 255, 0.05) 0%, transparent 70%);
  }

  .container { max-width: 1100px; margin: 0 auto; }

  .section-header { text-align: center; max-width: 700px; margin: 0 auto 4rem; }

  .section-header h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .section-header p { color: var(--text-muted); font-size: 1.1rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .card-icon { font-size: 2rem; margin-bottom: 1.25rem; display: inline-block; }

  .card h3 { font-size: 1.3rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-main); }

  .card p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; }

  .about-answer { margin-top: 1.5rem; }

  footer {
    text-align: center;
    padding: 3rem 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
    justify-content: center;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .footer-links a:hover { color: var(--accent); }
</style>