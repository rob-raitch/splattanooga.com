---
// src/components/SearchWidget.astro
---
<div class="search-widget-container" id="search-widget">
  <div class="widget">
    <p class="statement">
      How do I learn more about Gaussian Splatting?
    </p>
    <p class="statement-subtext">
      This interactive widget initiates a web search for information about Gaussian Splatting.<br>
      On the left, some example searches are provided in categories.<br>
      Choose your preferred search engine on the right and this will open in a new tab for you. Your choices are <a href="/privacy">remembered locally</a>.
    </p>

    <div class="selector-row">
      <select id="search-term">
        <optgroup label="Gaussian Splatting is completely new to me">
          <option value="What is Gaussian Splatting">What is Gaussian Splatting?</option>
          <option value="Gaussian Splatting explained for beginners">Splatting explained for beginners</option>
          <option value="3D Gaussian Splatting tutorial">3D Gaussian Splatting tutorial</option>
          <option value="How does Gaussian Splatting work">How does it work?</option>
          <option value="Gaussian Splatting vs photogrammetry">Splatting vs photogrammetry</option>
          <option value="Gaussian Splatting examples">Show me some examples</option>
        </optgroup>
        <optgroup label="I am familiar with Gaussian Splatting and want to explore more">
          <option value="Summarize the latest research papers about gaussian splatting with novel developments">Latest research papers with novel developments</option>
          <option value="How are HDR images being used with various gaussian splat algorithms?">How are HDR images being used?</option>
          <option value="What is the current state of AI-assisted augmentation to aid in gaussian splat reconstruction?">How is AI-assisted augmentation being used?</option>
        </optgroup>
      </select>

      <select id="search-engine">
        <option value="google">Google</option>
        <option value="duckduckgo">DuckDuckGo</option>
        <option value="startpage">Startpage</option>
        <option value="brave">Brave Search</option>
        <option value="ecosia">Ecosia</option>
        <option value="bing">Bing</option>
        <option value="lycos">Lycos</option>
      </select>

      <button class="go-btn" id="search-go-btn">GO</button>
    </div>

    <p class="note">
      You choose where to look as I don't own the search engine. :)<br>
      This approach is designed to give you the latest information and resources available on the web. This ensures the site never goes stale and you can always find the most up-to-date information.
    </p>
  </div>
</div>

<style>
  .search-widget-container {
    padding: 4rem 1.5rem;
    display: flex;
    justify-content: center;
  }
  
  .widget {
    background: var(--bg-surface);
    padding: 3rem 2rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    text-align: center;
    max-width: 650px;
    width: 100%;
  }

  .statement {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    line-height: 1.4;
    color: var(--text-main);
    font-weight: 600;
  }

  .statement-subtext {
    margin-bottom: 30px;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .selector-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 30px;
    flex-wrap: wrap;
    align-items: center;
  }

  select {
    padding: 12px 16px;
    font-size: 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    min-width: 200px;
    background: var(--bg-dark);
    color: var(--text-main);
    font-family: inherit;
  }
  
  select:focus {
    outline: none;
    border-color: var(--accent);
  }

  button.go-btn {
    padding: 12px 32px;
    font-size: 1rem;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  button.go-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(255, 102, 0, 0.3); /* matching the hsl(25, 100%, 50%) approx */
  }

  .note {
    margin-top: 30px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Mobile */
  @media (max-width: 500px) {
    .statement { font-size: 1.4rem; }
    .selector-row { flex-direction: column; }
    select, button.go-btn { width: 100%; }
  }
</style>

<script>
  const engines = {
    google: "https://www.google.com/search?q=",
    duckduckgo: "https://duckduckgo.com/?q=",
    startpage: "https://www.startpage.com/sp/search?query=",
    brave: "https://search.brave.com/search?q=",
    ecosia: "https://www.ecosia.org/search?q=",
    lycos: "https://lycos.com/search?kw=",
    bing: "https://www.bing.com/search?q="
  };

  let analyticsEnabled = false;

  const engineSelect = document.getElementById('search-engine');
  const goBtn = document.getElementById('search-go-btn');

  function launchSearch() {
    if (!engineSelect) return;
    
    const engine = engineSelect.value;
    let queryUrl = engines[engine];
    
    const termSelect = document.getElementById('search-term');
    const searchTerm = termSelect ? termSelect.value : "What is Gaussian Splatting";
    
    queryUrl += encodeURIComponent(searchTerm);
    
    localStorage.setItem('preferredSearchEngine', engine);
    if (termSelect) {
      localStorage.setItem('preferredSearchTerm', termSelect.value);
    }
    
    if (analyticsEnabled) {
      navigator.sendBeacon('/api/search-event', JSON.stringify({
        engine,
        search_term: searchTerm,
        timestamp: Date.now(),
        referrer: document.referrer || null,
        user_agent_type: navigator.userAgent.includes('Mobile') ? 'mobile' : 'desktop'
      }));
    }
    
    window.open(queryUrl, '_blank');
  }

  if (goBtn) {
    goBtn.addEventListener('click', launchSearch);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const savedEngine = localStorage.getItem('preferredSearchEngine');
    if (savedEngine && engines[savedEngine] && engineSelect) {
      engineSelect.value = savedEngine;
    }
    
    const savedTerm = localStorage.getItem('preferredSearchTerm');
    const termSelect = document.getElementById('search-term');
    if (savedTerm && termSelect) {
      // Check if the saved term is an option in the dropdown
      const optionExists = Array.from(termSelect.options).some(opt => opt.value === savedTerm);
      if (optionExists) {
        termSelect.value = savedTerm;
      }
    }
  });
</script>
